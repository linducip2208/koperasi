APP_NAME=KoperasiApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://koperasi.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# License pairing v3 (1 instalasi = 1 lisensi)
LICENSE_SERVER_URL=https://whitelabel.co.id
LICENSE_DEV_BYPASS=true
# LICENSE_HEARTBEAT_INTERVAL=86400
# LICENSE_HEARTBEAT_GRACE=604800

# WhatsApp Notification (driver: log|fonnte|wablas — kredensial harian via admin settings)
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_SENDER=
WHATSAPP_TIMEOUT=15
FONNTE_API_KEY=
FONNTE_SENDER=
WABLAS_API_KEY=
WABLAS_URL=

# Payment gateway (kredensial utama via admin Payment Gateway; env sebagai fallback)
# MIDTRANS_SERVER_KEY=
# XENDIT_API_KEY=

# PPOB supplier (provider: manual; kredensial via admin settings group=ppob)
# PPOB_API_KEY=

# Backup archive encryption (spatie/backup)
# BACKUP_ARCHIVE_PASSWORD=

# Vendor support produk (tampil di footer admin & halaman bantuan)
SUPPORT_WA=6281296052010
SUPPORT_WA_DISPLAY=0812-9605-2010
SUPPORT_EMAIL=support@whitelabel.co.id

# Product identity (jangan hardcode nama di kode)
PRODUCT_NAME="Koperasi Management System"
PRODUCT_SLUG=koperasi
PRODUCT_VENDOR=Whitelabel

# Koperasi Theme (emerald, stripe, linear, notion, discord)
KOPERASI_THEME=emerald

